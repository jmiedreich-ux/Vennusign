<Window x:Class="Vennu.DevControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vennu Development Control" Height="690" Width="980" MinHeight="620" MinWidth="820">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Vennu Development Control" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Starts and stops only processes launched by this application." Foreground="DimGray" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                <Button Content="Start all" Click="StartAll_Click" Margin="16,0,8,0" Padding="14,6" />
                <Button Content="Stop owned" Click="StopAll_Click" Padding="14,6" />
            </StackPanel>
        </StackPanel>
        <GroupBox DockPanel.Dock="Top" Header="API configuration bootstrap" Margin="0,0,0,16" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <Label Target="{Binding ElementName=ConfigurationEnvironment}" Padding="0,0,0,4">Environment</Label>
                    <ComboBox x:Name="ConfigurationEnvironment" SelectedIndex="0">
                        <ComboBoxItem Content="Development" />
                        <ComboBoxItem Content="Test" />
                        <ComboBoxItem Content="Staging" />
                        <ComboBoxItem Content="Production" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                    <Label Target="{Binding ElementName=KeyProvider}" Padding="0,0,0,4">Key provider</Label>
                    <ComboBox x:Name="KeyProvider" SelectedIndex="0" SelectionChanged="KeyProvider_SelectionChanged">
                        <ComboBoxItem Content="Environment" />
                        <ComboBoxItem Content="AzureKeyVault" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <Label Target="{Binding ElementName=ConfigurationConnectionString}" Padding="0,0,0,4">Configuration database connection string</Label>
                    <PasswordBox x:Name="ConfigurationConnectionString" PasswordChar="?" />
                </StackPanel>
                <StackPanel x:Name="LocalKeyPanel" Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                    <Label Target="{Binding ElementName=LocalConfigurationKey}" Padding="0,0,0,4">Local encryption key</Label>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Generate" Click="GenerateLocalKey_Click" Margin="8,0,0,0" Padding="12,5" />
                        <PasswordBox x:Name="LocalConfigurationKey" PasswordChar="?" />
                    </DockPanel>
                </StackPanel>
                <StackPanel x:Name="KeyVaultPanel" Grid.Row="2" Grid.Column="1" Margin="12,0,0,12" IsEnabled="False">
                    <Label Target="{Binding ElementName=KeyVaultKeyId}" Padding="0,0,0,4">Azure Key Vault key ID</Label>
                    <TextBox x:Name="KeyVaultKeyId" />
                </StackPanel>
                <Grid Grid.Row="3" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Apply to API starts" Click="ApplyBootstrap_Click" Padding="12,6" Margin="0,0,8,0" />
                        <Button Content="Save to Windows user environment" Click="SaveBootstrap_Click" Padding="12,6" Margin="0,0,8,0" />
                        <Button Content="Clear saved values" Click="ClearBootstrap_Click" Padding="12,6" />
                    </StackPanel>
                    <TextBlock x:Name="BootstrapStatus" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Grid>
        </GroupBox>
        <DataGrid x:Name="ServicesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                <DataGridTemplateColumn Header="Actions" Width="320">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Start" Tag="{Binding}" Click="Start_Click" Margin="0,0,8,0" Padding="10,4" />
                                <Button Content="Stop" Tag="{Binding}" Click="Stop_Click" Margin="0,0,8,0" Padding="10,4" />
                                <Button Content="Restart" Tag="{Binding}" Click="Restart_Click" Margin="0,0,8,0" Padding="10,4" />
                                <Button Content="Open" Tag="{Binding}" Click="Open_Click" Padding="10,4" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
