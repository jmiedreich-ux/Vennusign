# Build-time configuration for the dev deployment of Back Office.
#
# This lives beside the application, not in the deploy workflow, so that a
# change to it deploys THIS app and nothing else. When these values were in
# deploy-dev.yml, the classifier could not tell "someone reordered the jobs"
# from "someone changed the API every front end is compiled against", so it
# failed safe and redeployed all five. See issue #736.
VITE_API_URL=https://dev.api.vennusign.com
