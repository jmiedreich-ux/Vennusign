{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vennusign.com/schemas/release-manifest-v1.json",
  "title": "Vennusign release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productVersion", "configurationSchemaVersion", "database", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productVersion": { "$ref": "#/$defs/semver" },
    "configurationSchemaVersion": { "$ref": "#/$defs/contractVersion" },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "compatibility", "procedureContracts"],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^[0-9]{8}\\.[0-9]{2}$" },
        "compatibility": { "enum": ["expand-and-contract"] },
        "procedureContracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
              "version": { "$ref": "#/$defs/contractVersion" }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "contractVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "version", "state", "artifact"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": { "enum": ["web", "api", "service", "player", "tv-shell", "contract", "database", "infrastructure", "configuration"] },
        "version": { "$ref": "#/$defs/semver" },
        "state": { "enum": ["changed", "carried-forward"] },
        "buildNumber": { "type": "integer", "minimum": 1 },
        "contractMajor": { "type": "integer", "minimum": 1 },
        "compatibility": { "type": "string", "pattern": "^>=[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+$" },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceCommit", "buildId", "immutable"],
          "properties": {
            "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "buildId": { "type": "string", "minLength": 1, "maxLength": 100 },
            "immutable": { "const": true }
          }
        }
      }
    }
  }
}
