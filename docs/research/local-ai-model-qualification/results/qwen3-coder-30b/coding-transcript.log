print('Second hold with same ID created successfully')
print(f'Same hold? {hold1 == hold2}')

# Try to create same request but with different parameters (should raise IdempotencyConflict)
try:
    service.create_hold(HoldRequest('r-1', 'show-a', 3, Decimal('12.50'), False))
    print('ERROR: Should have raised IdempotencyConflict')
except IdempotencyConflict as e:
    print('Idempotency conflict correctly raised:', str(e))

# Test unknown show
